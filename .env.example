# ============================================================================
# CRM Master — variables d'environnement
# Copier ce fichier en `.env` (développement) et renseigner les valeurs
# réelles en production dans la configuration de l'hébergeur.
# ============================================================================

# --- Base de données (obligatoire) -----------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/crm_master?schema=public"
# Connexion directe (non poolée), utilisée uniquement par Prisma Migrate.
# Requise avec un fournisseur qui poole DATABASE_URL via PgBouncer en mode
# transaction (ex. Neon) — sinon, mettre la même valeur que DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/crm_master?schema=public"

# --- Application (obligatoire) ----------------------------------------------
# URL publique de l'application (utilisée dans les emails, le lien de
# réservation publique, etc.)
APP_URL="http://localhost:3000"

# --- Session --------------------------------------------------------------
SESSION_COOKIE_NAME="crm_master_session"
SESSION_TTL_HOURS=12

# --- Email (SMTP) — optionnel, non requis pour l'authentification ----------
# Les identifiants (création de compte, mot de passe) sont entièrement
# gérés par un administrateur dans /admin/users — il n'y a ni 2FA ni
# réinitialisation en self-service par email. SMTP sert uniquement à
# l'email de bienvenue optionnel et aux feuilles de pointage envoyées par
# email. Sans ces variables, les emails sont journalisés côté serveur au
# lieu d'être envoyés.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CRM Master <no-reply@votre-domaine.fr>"
SMTP_SECURE=false

# --- Temps réel (Pusher Channels) — optionnel -------------------------------
# Sans ces variables, l'application reste fonctionnelle (secours par
# rafraîchissement/sondage) mais sans mise à jour instantanée entre
# utilisateurs. Créer un compte sur pusher.com (offre gratuite suffisante
# pour démarrer) pour obtenir ces valeurs.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# Ces deux variables sont exposées au navigateur (préfixe NEXT_PUBLIC_
# obligatoire côté Next.js) — ce sont des identifiants publics, pas des
# secrets.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- Stockage des documents --------------------------------------------------
# "local" (par défaut, écrit dans STORAGE_LOCAL_PATH — À NE JAMAIS UTILISER en
# production sur un hébergeur sans disque persistant comme Vercel, le disque y
# est en lecture seule et chaque dépôt de document échoue), "vercel-blob"
# (recommandé sur Vercel : `vercel blob create-store <nom> --access private`
# renseigne automatiquement BLOB_READ_WRITE_TOKEN sur le projet) ou "s3"
# (compatible AWS S3 ou tout stockage compatible S3 : Cloudflare R2,
# Backblaze B2, MinIO...).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
BLOB_READ_WRITE_TOKEN=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Uniquement nécessaire pour un fournisseur S3-compatible non-AWS.
S3_ENDPOINT=

# --- Tâches planifiées (automatisations) ------------------------------------
# Secret partagé avec le service de cron externe (Vercel Cron, cron-job.org,
# etc.) qui doit appeler POST /api/public/cron/automations avec l'en-tête
# `x-cron-secret`. Sans cette variable, la route refuse toute requête.
CRON_SECRET=

# --- Données de démonstration (script prisma/seed.ts) -----------------------
# Utilisées uniquement lors de l'exécution de `npm run seed`.
ADMIN_EMAIL=admin@crm-master.local
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_PASSWORD=ChangeMoi123!
