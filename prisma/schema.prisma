// CRM Master — schema de données
// Règle fondamentale : toute table métier porte un crmId et TOUTE requête
// applicative doit filtrer par ce crmId (voir src/server/tenant.ts).
// Le schéma n'impose pas l'isolation à lui seul : elle est garantie par la
// couche serveur (src/server/*), jamais par l'UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Connexion directe (non poolée) utilisée uniquement par Prisma Migrate.
  // Nécessaire avec les fournisseurs qui exposent DATABASE_URL derrière un
  // pooler PgBouncer en mode transaction (ex. Neon) : ce mode ne supporte
  // pas les verrous consultatifs que Migrate utilise pour éviter les
  // migrations concurrentes. Sans pooler, DIRECT_URL peut simplement
  // pointer vers la même valeur que DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// IDENTITÉ, AUTHENTIFICATION, SÉCURITÉ
// ============================================================================

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Presence {
  ONLINE
  AWAY
  OFFLINE
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id                 String          @id @default(cuid())
  firstName          String
  lastName           String
  email              String          @unique
  passwordHash       String
  mustChangePassword Boolean         @default(true)
  isGlobalAdmin      Boolean         @default(false)
  status             UserStatus      @default(ACTIVE)
  color              String          @default("#3b6bf5")
  avatarUrl          String?
  signatureText      String?
  signatureImageUrl  String?
  presence           Presence        @default(OFFLINE)
  lastActiveAt       DateTime?
  theme              ThemePreference @default(SYSTEM)
  notifyByEmail      Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  disabledAt         DateTime?
  createdById        String?

  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[] @relation("UserCreatedBy")

  crmAccess              UserCrmAccess[]
  sessions               Session[]
  ownedClients           Client[]                   @relation("ClientOwner")
  clientCollabs          ClientCollaborator[]
  ownedProspects         Prospect[]                 @relation("ProspectOwner")
  ownedOpportunities     Opportunity[]              @relation("OpportunityOwner")
  ownedAppointments      Appointment[]              @relation("AppointmentOwner")
  appointmentInvites     AppointmentParticipant[]
  assignedTasks          Task[]                     @relation("TaskAssignee")
  createdTasks           Task[]                     @relation("TaskCreatedBy")
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  createdQuotes          Quote[]                    @relation("QuoteCreatedBy")
  quoteVersions          QuoteVersion[]
  uploadedDocuments      Document[]
  createdThreads         MessageThread[]
  threadParticipants     MessageThreadParticipant[]
  messages               Message[]
  notifications          Notification[]             @relation("NotificationRecipient")
  triggeredNotifications Notification[]             @relation("NotificationActor")
  objectives             CommercialObjective[]
  activityLogs           ActivityLog[]
  tags                   UserTag[]
  createdChantiers       Chantier[]                 @relation("ChantierCreatedBy")
  chantierAssignments    ChantierAssignment[]       @relation("ChantierAssignments")
  vaultDocuments         VaultDocument[]            @relation("VaultDocumentOwner")
  uploadedVaultDocuments VaultDocument[]            @relation("VaultDocumentUploadedBy")
  foremanVaultDocuments  VaultDocument[]            @relation("VaultDocumentForeman")
  vaultFolders           VaultFolder[]              @relation("VaultFolderOwner")
  createdVaultFolders    VaultFolder[]              @relation("VaultFolderCreatedBy")
  pointagesAsEmployee    Pointage[]                 @relation("PointageEmployee")
  pointagesAsForeman     Pointage[]                 @relation("PointageForeman")
  createdApiKeys         ApiKey[]                   @relation("ApiKeyCreatedBy")

  @@index([email])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

/**
 * Limitation de fréquence générique par IP pour les points d'entrée publics
 * non authentifiés (ex. réservation en ligne — voir src/lib/rate-limit.ts),
 * sur le même principe que LoginAttempt sans être spécifique aux
 * identifiants de connexion.
 */
model RateLimitHit {
  id         String   @id @default(cuid())
  scope      String
  identifier String
  createdAt  DateTime @default(now())

  @@index([scope, identifier, createdAt])
}

// ============================================================================
// CRM (TENANT) — chaque CRM est un espace strictement isolé
// ============================================================================

model Crm {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String   @default("building")
  color       String   @default("#3b6bf5")
  isActive    Boolean  @default(true)
  isDemo      Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAccess             UserCrmAccess[]
  companySettings        CompanySettings?
  pointageSettings       CrmPointageSettings?
  bookingSettings        BookingSettings?
  pipelineStages         PipelineStage[]
  sources                Source[]
  tags                   Tag[]
  customFieldDefs        CustomFieldDefinition[]
  vatRates               VatRate[]
  quoteTemplates         QuoteTemplate[]
  emailTemplates         EmailTemplate[]
  automationRules        AutomationRule[]
  clients                Client[]
  prospects              Prospect[]
  opportunities          Opportunity[]
  appointments           Appointment[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  tasks                  Task[]
  quotes                 Quote[]
  quoteCounters          QuoteCounter[]
  documents              Document[]
  messageThreads         MessageThread[]
  messages               Message[]
  notifications          Notification[]
  activityLogs           ActivityLog[]
  objectives             CommercialObjective[]
  customFieldValues      CustomFieldValue[]
  chantiers              Chantier[]
  vaultDocuments         VaultDocument[]
  vaultFolders           VaultFolder[]
  pointages              Pointage[]

  @@index([slug])
}

enum CrmRole {
  MANAGER // Responsable CRM
  USER // Utilisateur
}

enum Permission {
  VIEW
  CREATE
  EDIT
  DELETE
  EXPORT
  MANAGE_APPOINTMENTS
  MANAGE_QUOTES
  MANAGE_PROSPECTS
  MANAGE_CLIENTS
  MANAGE_SETTINGS
  MANAGE_USERS
}

// Catégorie d'accès d'un utilisateur pour un CRM donné : détermine quels
// onglets/fonctions sont visibles, indépendamment du rôle (MANAGER/USER)
// qui ne joue que sur le niveau de permission au sein de la catégorie
// COMMERCIAL. Un OUVRIER n'a par défaut aucune permission commerciale
// (voir src/server/permissions.ts effectivePermissions) : seuls Planning
// et Coffre-fort lui sont accessibles, appliqué à la fois côté navigation
// (src/lib/nav.ts) et côté serveur (src/app/c/[crmSlug]/layout.tsx).
// SECRETAIRE n'a, comme OUVRIER, aucune permission commerciale par défaut,
// mais a accès en plus à Tableau de bord, Utilisateurs (gestion des accès
// de CE CRM), Planning, Pointage salariés/client, Coffre-fort et Activité —
// jamais à Pipeline/Agenda/Clients/Prospects/Devis/Tâches/Messagerie/
// Paramètres CRM (données commerciales), voir canManageOperations dans
// src/server/tenant.ts.
enum AccessCategory {
  COMMERCIAL
  OUVRIER
  SECRETAIRE
}

// Défaut de permissions accordées automatiquement par rôle : voir
// src/server/permissions.ts — cette table permet des dérogations fines.
model UserCrmAccess {
  id          String         @id @default(cuid())
  userId      String
  crmId       String
  role        CrmRole        @default(USER)
  category    AccessCategory @default(COMMERCIAL)
  permissions Permission[]
  grantedAt   DateTime       @default(now())
  grantedById String?

  // Profil "chef de chantier" (catégorie OUVRIER uniquement) : géré comme
  // un profil de la personne elle-même, pas comme un rôle propre à chaque
  // chantier — un chef de chantier gère la feuille de pointage de tout
  // chantier auquel il est affecté (voir ChantierAssignment). Choisi à la
  // création/l'édition de l'utilisateur (src/app/admin/users), déclenche
  // l'accès aux onglets Pointage salariés/client (src/server/pointage/actions.ts
  // amIForeman/requireForeman).
  isForeman Boolean @default(false)

  // Montants par défaut des primes de pointage (catégorie OUVRIER
  // uniquement) : pré-remplis automatiquement par le chef de chantier lors
  // de la saisie d'une feuille de pointage salarié, mais reste modifiable
  // au cas par cas. Voir src/server/pointage. (Les primes management/zone/
  // masque/poste sont fixées par chantier, pas par salarié — voir
  // ChantierFixedAmounts dans src/server/pointage/calc.ts — donc absentes ici.)
  defaultHousingAllowance Decimal @default(0) @db.Decimal(8, 2)
  defaultDirtAllowance    Decimal @default(5) @db.Decimal(8, 2)
  // Taux horaire de base du salarié, servant à calculer la majoration de
  // nuit (voir Pointage.hourlyRate/nightRatePercent et
  // src/server/pointage/calc.ts) : nuit = heures de nuit × taux horaire ×
  // % de majoration.
  defaultHourlyRate Decimal @default(0) @db.Decimal(8, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  crm  Crm  @relation(fields: [crmId], references: [id], onDelete: Cascade)

  @@unique([userId, crmId])
  @@index([crmId])
}

model CompanySettings {
  id                        String   @id @default(cuid())
  crmId                     String   @unique
  crm                       Crm      @relation(fields: [crmId], references: [id], onDelete: Cascade)
  legalName                 String   @default("")
  logoUrl                   String?
  address                   String   @default("")
  postalCode                String   @default("")
  city                      String   @default("")
  siret                     String   @default("")
  phone                     String   @default("")
  email                     String   @default("")
  website                   String   @default("")
  legalMentions             String   @default("")
  // Utilisés pour l'en-tête de l'ordre de mission (voir src/server/mission-order).
  ape                       String   @default("")
  urssafOffice              String   @default("")
  legalRepresentative       String   @default("")
  missionOrderLegalMentions String   @default("")
  updatedAt                 DateTime @updatedAt
}

// Taux commun à tout le CRM pour le calcul automatique des feuilles de
// pointage (heures de nuit) — voir src/server/pointage. Les indemnités
// journalières (repas, grand déplacement) sont désormais fixées par
// chantier (voir Chantier) et les primes individuelles (logement,
// salissure...) par salarié sur UserCrmAccess.
model CrmPointageSettings {
  id        String   @id @default(cuid())
  crmId     String   @unique
  crm       Crm      @relation(fields: [crmId], references: [id], onDelete: Cascade)
  // % de majoration nuit par défaut (voir Pointage.nightRatePercent) —
  // remplace l'ancien taux fixe en euros : la majoration se calcule
  // maintenant à partir du taux horaire de base du salarié (voir
  // UserCrmAccess.defaultHourlyRate).
  nightRatePercent Decimal  @default(25) @db.Decimal(5, 2)
  updatedAt        DateTime @updatedAt
}

model BookingSettings {
  id                   String   @id @default(cuid())
  crmId                String   @unique
  crm                  Crm      @relation(fields: [crmId], references: [id], onDelete: Cascade)
  publicSlug           String   @unique
  isEnabled            Boolean  @default(true)
  slotDurationMinutes  Int      @default(30)
  bufferMinutes        Int      @default(0)
  minNoticeHours       Int      @default(24)
  maxAdvanceDays       Int      @default(60)
  balancedDistribution Boolean  @default(false)
  introMessage         String?
  updatedAt            DateTime @updatedAt
}

// ============================================================================
// CONFIGURATION PAR CRM : pipeline, sources, tags, champs personnalisés, TVA
// ============================================================================

model PipelineStage {
  id        String   @id @default(cuid())
  crmId     String
  crm       Crm      @relation(fields: [crmId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  color     String   @default("#94a3b8")
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  createdAt DateTime @default(now())

  opportunities Opportunity[]

  @@index([crmId])
}

model Source {
  id    String @id @default(cuid())
  crmId String
  crm   Crm    @relation(fields: [crmId], references: [id], onDelete: Cascade)
  name  String
  order Int    @default(0)

  clients   Client[]
  prospects Prospect[]

  @@unique([crmId, name])
}

enum TagScope {
  CLIENT
  PROSPECT
  USER
}

model Tag {
  id    String   @id @default(cuid())
  crmId String
  crm   Crm      @relation(fields: [crmId], references: [id], onDelete: Cascade)
  scope TagScope
  name  String
  color String   @default("#94a3b8")

  clientTags   ClientTag[]
  prospectTags ProspectTag[]
  userTags     UserTag[]

  @@unique([crmId, scope, name])
}

enum CustomFieldEntity {
  CLIENT
  PROSPECT
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

model CustomFieldDefinition {
  id         String            @id @default(cuid())
  crmId      String
  crm        Crm               @relation(fields: [crmId], references: [id], onDelete: Cascade)
  entityType CustomFieldEntity
  label      String
  fieldType  CustomFieldType
  options    String[]          @default([])
  required   Boolean           @default(false)
  order      Int               @default(0)

  values CustomFieldValue[]

  @@index([crmId, entityType])
}

model CustomFieldValue {
  id           String                @id @default(cuid())
  crmId        String
  crm          Crm                   @relation(fields: [crmId], references: [id], onDelete: Cascade)
  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  entityType   CustomFieldEntity
  entityId     String
  value        String?

  @@unique([definitionId, entityId])
  @@index([crmId, entityType, entityId])
}

model VatRate {
  id        String  @id @default(cuid())
  crmId     String
  crm       Crm     @relation(fields: [crmId], references: [id], onDelete: Cascade)
  label     String
  rate      Decimal @db.Decimal(5, 2)
  isDefault Boolean @default(false)

  quoteItems QuoteItem[]

  @@unique([crmId, label])
}

// ============================================================================
// CLIENTS & PROSPECTS
// ============================================================================

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id              String       @id @default(cuid())
  crmId           String
  crm             Crm          @relation(fields: [crmId], references: [id], onDelete: Cascade)
  company         String
  sector          String?
  firstName       String?
  lastName        String?
  phone           String?
  email           String?
  address         String?
  activity        String?
  size            String?
  siret           String?
  status          ClientStatus @default(ACTIVE)
  notes           String?
  sourceId        String?
  source          Source?      @relation(fields: [sourceId], references: [id])
  ownerId         String
  owner           User         @relation("ClientOwner", fields: [ownerId], references: [id])
  commercialValue Decimal?     @db.Decimal(12, 2)
  revenue         Decimal?     @db.Decimal(12, 2)
  lastContactAt   DateTime?
  nextContactAt   DateTime?
  convertedFromId String?      @unique
  convertedFrom   Prospect?    @relation("ProspectConversion", fields: [convertedFromId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  contacts      ClientContact[]
  collaborators ClientCollaborator[]
  tags          ClientTag[]
  opportunities Opportunity[]
  appointments  Appointment[]
  tasks         Task[]
  quotes        Quote[]
  documents     Document[]
  activityLogs  ActivityLog[]

  @@index([crmId, status])
  @@index([crmId, ownerId])
  @@index([crmId, siret])
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  role      String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
}

model ClientCollaborator {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
}

model ClientTag {
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tagId    String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
}

model UserTag {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
}

enum ProspectStatus {
  HOT
  COLD
  TO_FOLLOW_UP
  CONVERTED
  LOST
}

model Prospect {
  id              String         @id @default(cuid())
  crmId           String
  crm             Crm            @relation(fields: [crmId], references: [id], onDelete: Cascade)
  company         String
  firstName       String?
  lastName        String?
  phone           String?
  email           String?
  address         String?
  siret           String?
  sector          String?
  activity        String?
  size            String?
  sourceId        String?
  source          Source?        @relation(fields: [sourceId], references: [id])
  ownerId         String
  owner           User           @relation("ProspectOwner", fields: [ownerId], references: [id])
  status          ProspectStatus @default(TO_FOLLOW_UP)
  score           Int            @default(0)
  scoreBreakdown  Json?
  potentialAmount Decimal?       @db.Decimal(12, 2)
  notes           String?
  lastContactAt   DateTime?
  nextContactAt   DateTime?
  lostReason      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  contacts      ProspectContact[]
  tags          ProspectTag[]
  opportunities Opportunity[]
  appointments  Appointment[]
  tasks         Task[]
  quotes        Quote[]
  documents     Document[]
  activityLogs  ActivityLog[]
  convertedTo   Client?           @relation("ProspectConversion")

  @@index([crmId, status])
  @@index([crmId, ownerId])
  @@index([crmId, siret])
}

model ProspectContact {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  role       String?
  phone      String?
  email      String?
  createdAt  DateTime @default(now())
}

model ProspectTag {
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([prospectId, tagId])
}

// ============================================================================
// PIPELINE COMMERCIAL
// ============================================================================

model Opportunity {
  id             String        @id @default(cuid())
  crmId          String
  crm            Crm           @relation(fields: [crmId], references: [id], onDelete: Cascade)
  stageId        String
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id])
  prospectId     String?
  prospect       Prospect?     @relation(fields: [prospectId], references: [id])
  title          String
  amount         Decimal?      @db.Decimal(12, 2)
  ownerId        String
  owner          User          @relation("OpportunityOwner", fields: [ownerId], references: [id])
  position       Int           @default(0)
  nextAction     String?
  lastActivityAt DateTime      @default(now())
  wonAt          DateTime?
  lostAt         DateTime?
  lostReason     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  history OpportunityHistory[]

  @@index([crmId, stageId])
}

model OpportunityHistory {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStageId   String?
  toStageId     String
  movedById     String
  createdAt     DateTime    @default(now())
}

// ============================================================================
// AGENDA & RÉSERVATION
// ============================================================================

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id                  String            @id @default(cuid())
  crmId               String
  crm                 Crm               @relation(fields: [crmId], references: [id], onDelete: Cascade)
  title               String
  clientId            String?
  client              Client?           @relation(fields: [clientId], references: [id])
  prospectId          String?
  prospect            Prospect?         @relation(fields: [prospectId], references: [id])
  ownerId             String
  owner               User              @relation("AppointmentOwner", fields: [ownerId], references: [id])
  startAt             DateTime
  endAt               DateTime
  location            String?
  phone               String?
  email               String?
  notes               String?
  status              AppointmentStatus @default(SCHEDULED)
  isPublicBooking     Boolean           @default(false)
  bookingContactName  String?
  bookingContactEmail String?
  bookingContactPhone String?
  bookingMessage      String?

  reportSummary    String?
  reportNeeds      String?
  reportBudget     String?
  reportNextStep   String?
  reportFollowUpAt DateTime?
  reportNotes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants AppointmentParticipant[]
  tasks        Task[]
  documents    Document[]
  activityLogs ActivityLog[]

  @@index([crmId, ownerId, startAt])
  @@index([crmId, startAt])
}

model AppointmentParticipant {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, userId])
}

model AvailabilityRule {
  id        String @id @default(cuid())
  crmId     String
  crm       Crm    @relation(fields: [crmId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday   Int // 0 = lundi ... 6 = dimanche
  startTime String // "09:00"
  endTime   String // "12:00"

  @@index([crmId, userId, weekday])
}

enum AvailabilityExceptionType {
  LEAVE
  HOLIDAY
  UNAVAILABLE
  BLOCKED
}

model AvailabilityException {
  id        String                    @id @default(cuid())
  crmId     String
  crm       Crm                       @relation(fields: [crmId], references: [id], onDelete: Cascade)
  userId    String
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AvailabilityExceptionType
  startAt   DateTime
  endAt     DateTime
  allDay    Boolean                   @default(true)
  reason    String?
  createdAt DateTime                  @default(now())

  @@index([crmId, userId, startAt])
}

// ============================================================================
// TÂCHES
// ============================================================================

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id            String       @id @default(cuid())
  crmId         String
  crm           Crm          @relation(fields: [crmId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  assigneeId    String
  assignee      User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id])
  prospectId    String?
  prospect      Prospect?    @relation(fields: [prospectId], references: [id])
  quoteId       String?
  quote         Quote?       @relation(fields: [quoteId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  priority      TaskPriority @default(NORMAL)
  status        TaskStatus   @default(TODO)
  dueAt         DateTime?
  createdById   String
  createdBy     User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  isAutomated   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  completedAt   DateTime?

  @@index([crmId, assigneeId, status])
  @@index([crmId, dueAt])
}

// ============================================================================
// DEVIS
// ============================================================================

enum QuoteStatus {
  DRAFT
  SENT
  FOLLOWED_UP
  ACCEPTED
  REFUSED
  EXPIRED
}

model QuoteCounter {
  id         String @id @default(cuid())
  crmId      String
  crm        Crm    @relation(fields: [crmId], references: [id], onDelete: Cascade)
  prefix     String
  year       Int
  lastNumber Int    @default(0)

  @@unique([crmId, prefix, year])
}

model Quote {
  id             String      @id @default(cuid())
  crmId          String
  crm            Crm         @relation(fields: [crmId], references: [id], onDelete: Cascade)
  number         String
  clientId       String?
  client         Client?     @relation(fields: [clientId], references: [id])
  object         String
  siretSnapshot  String?
  issueDate      DateTime    @default(now())
  validUntil     DateTime
  status         QuoteStatus @default(DRAFT)
  conditions     String?
  mentions       String?
  totalHt        Decimal     @default(0) @db.Decimal(12, 2)
  totalVat       Decimal     @default(0) @db.Decimal(12, 2)
  totalTtc       Decimal     @default(0) @db.Decimal(12, 2)
  currentVersion Int         @default(1)
  createdById    String
  createdBy      User        @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  signedById     String?
  sentAt         DateTime?
  acceptedAt     DateTime?
  refusedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items        QuoteItem[]
  versions     QuoteVersion[]
  tasks        Task[]
  documents    Document[]
  activityLogs ActivityLog[]
  prospect     Prospect?      @relation(fields: [prospectId], references: [id])
  prospectId   String?

  @@unique([crmId, number])
  @@index([crmId, status])
  @@index([crmId, clientId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  designation String
  quantity    Decimal @db.Decimal(10, 2)
  unitPriceHt Decimal @db.Decimal(12, 2)
  vatRateId   String
  vatRate     VatRate @relation(fields: [vatRateId], references: [id])
  order       Int     @default(0)
}

model QuoteVersion {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshot      Json
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  note          String?
  createdAt     DateTime @default(now())

  @@unique([quoteId, versionNumber])
}

model QuoteTemplate {
  id           String   @id @default(cuid())
  crmId        String
  crm          Crm      @relation(fields: [crmId], references: [id], onDelete: Cascade)
  name         String
  logoUrl      String?
  primaryColor String   @default("#3b6bf5")
  mentions     String?
  conditions   String?
  footer       String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([crmId])
}

// ============================================================================
// DOCUMENTS
// ============================================================================

enum DocumentEntity {
  CLIENT
  PROSPECT
  QUOTE
  APPOINTMENT
  MESSAGE
}

model Document {
  id           String         @id @default(cuid())
  crmId        String
  crm          Crm            @relation(fields: [crmId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  storageKey   String
  entityType   DocumentEntity
  entityId     String
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
