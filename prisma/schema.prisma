// ============================================================================
// PLANNING (accès Ouvrier) — chantiers annuels et affectations
// ============================================================================

enum ChantierStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model Chantier {
  id          String         @id @default(cuid())
  crmId       String
  crm         Crm            @relation(fields: [crmId], references: [id], onDelete: Cascade)
  name        String
  description String?
  address     String?
  startDate   DateTime
  endDate     DateTime
  color       String         @default("#0891b2")
  status      ChantierStatus @default(PLANNED)
  createdById String
  createdBy   User           @relation("ChantierCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Indemnités fixes du chantier (catégorie OUVRIER) : communes à tous les
  // salariés qui y sont mobilisés. La feuille de pointage salarié ne fait
  // plus que cocher/décocher lesquelles s'appliquent — le montant vient
  // toujours d'ici. Voir src/server/pointage/calc.ts.
  lunchAllowance  Decimal @default(0) @db.Decimal(8, 2)
  dinnerAllowance Decimal @default(0) @db.Decimal(8, 2)
  travelAllowance Decimal @default(0) @db.Decimal(8, 2)
  maskBonus       Decimal @default(0) @db.Decimal(8, 2)
  managementBonus Decimal @default(0) @db.Decimal(8, 2)
  zoneBonus       Decimal @default(0) @db.Decimal(8, 2)
  postBonus       Decimal @default(0) @db.Decimal(8, 2)
  // Ajoutés pour le tableau de comptabilité (transformation des fiches de
  // pointage déposées en tableau Excel — voir src/server/accounting).
  mealAllowance Decimal @default(9.81) @db.Decimal(8, 2)
  clothingBonus Decimal @default(0) @db.Decimal(8, 2)

  // Informations de mission, utilisées pour générer l'ordre de mission de
  // chaque salarié affecté (voir src/server/mission-order).
  missionNature      String?
  clientName         String?
  siteContactName    String?
  siteContactPhone   String?
  importantDocuments String?

  assignments    ChantierAssignment[]
  pointages      Pointage[]
  vaultDocuments VaultDocument[]

  @@index([crmId, startDate])
}

model ChantierAssignment {
  id         String    @id @default(cuid())
  chantierId String
  chantier   Chantier  @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation("ChantierAssignments", fields: [userId], references: [id], onDelete: Cascade)
  startDate  DateTime?
  endDate    DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  // Données variables de la mission de ce salarié sur ce chantier, saisies
  // par l'admin à l'attribution (modifiables ensuite). Alimentent la
  // feuille de pointage (remboursements km/trajet) et l'ordre de mission.
  workerAddress       String?
  kmRate              Decimal? @db.Decimal(8, 3)
  distanceKm          Decimal? @db.Decimal(8, 2)
  travelHourlyRate    Decimal? @db.Decimal(8, 2)
  travelDurationHours Decimal? @db.Decimal(6, 2)

  // Données propres à ce salarié sur ce chantier, pour le tableau de
  // comptabilité (varient d'un salarié à l'autre, contrairement aux
  // indemnités fixes du chantier — voir Chantier ci-dessus).
  sncfExpense   Decimal? @db.Decimal(8, 2)
  roomDeduction Decimal? @db.Decimal(8, 2)

  @@unique([chantierId, userId])
  @@index([userId])
}

// Saisie hebdomadaire des heures d'un salarié sur un chantier par son chef
// de chantier (FOREMAN). `days` stocke le détail des 7 jours
// (lundi → dimanche) sous la forme [{date, normal, matin, apresMidi,
// nuit}], en heures décimales. Les 9 indemnités/primes communes à tout le
// chantier (voir Chantier) et les 2 remboursements de trajet propres à
// cette affectation (voir ChantierAssignment) ne sont plus saisis en
// montant ici : le chef de chantier coche seulement lesquels s'appliquent
// (*Applied) — le montant est calculé à l'affichage à partir du chantier
// et de l'affectation. Seules les primes propres au salarié (logement,
// salissure) et le taux horaire de nuit restent des montants saisis ici,
// pré-remplis depuis UserCrmAccess mais ajustables par semaine. Voir
// src/server/pointage/actions.ts et src/server/pointage/calc.ts.
model Pointage {
  id         String   @id @default(cuid())
  crmId      String
  crm        Crm      @relation(fields: [crmId], references: [id], onDelete: Cascade)
  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User     @relation("PointageEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  foremanId  String
  foreman    User     @relation("PointageForeman", fields: [foremanId], references: [id])
  weekStart  DateTime // lundi de la semaine concernée, normalisé à minuit
  days       Json

  housingAllowance Decimal @default(0) @db.Decimal(8, 2)
  dirtAllowance    Decimal @default(0) @db.Decimal(8, 2)

  // Taux propres à CETTE fiche (salarié + semaine), choisis par le chef de
  // chantier — pré-remplis depuis UserCrmAccess.defaultHourlyRate et
  // CrmPointageSettings.nightRatePercent pour une fiche encore jamais
  // saisie, ajustables ensuite. Majoration nuit = heures de nuit × taux
  // horaire × % de majoration ; par défaut à 0 : tant que le taux horaire
  // n'est pas renseigné, aucune ligne "heures de nuit" n'apparaît sur le PDF.
  hourlyRate       Decimal @default(0) @db.Decimal(8, 2)
  nightRatePercent Decimal @default(0) @db.Decimal(5, 2)

  // Cases à cocher : montant fixé par le chantier (lunch/dinner/travel/
  // mask/management/zone/post/meal/clothing) ou calculé à partir de
  // l'affectation (km/travelHours), jamais saisi ici.
  lunchAllowanceApplied           Boolean @default(false)
  dinnerAllowanceApplied          Boolean @default(false)
  travelAllowanceApplied          Boolean @default(false)
  maskBonusApplied                Boolean @default(false)
  managementBonusApplied          Boolean @default(false)
  zoneBonusApplied                Boolean @default(false)
  postBonusApplied                Boolean @default(false)
  kmReimbursementApplied          Boolean @default(false)
  travelHoursReimbursementApplied Boolean @default(false)
  mealAllowanceApplied            Boolean @default(false)
  clothingBonusApplied            Boolean @default(false)

  comments String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vaultDocuments VaultDocument[]

  @@unique([chantierId, employeeId, weekStart])
  @@index([crmId, weekStart])
}

// ============================================================================
// COFFRE-FORT (Ouvrier + Commercial) — documents personnels, isolés par
// utilisateur : jamais visibles par un autre utilisateur. Déposés par un
// administrateur, ou par un chef de chantier pour les feuilles de pointage
// qu'il génère (voir src/server/vault/actions.ts et
// src/server/pointage/actions.ts).
// ============================================================================

enum VaultDocumentCategory {
  PAYSLIP
  DOCUMENT
  TIMESHEET_EMPLOYEE
  TIMESHEET_CLIENT
  MISSION_ORDER
  ACCOUNTING_EXPORT
}

// Dossier réel (façon "drive"), propre au coffre-fort d'un utilisateur
// (ownerUserId) — imbriqué via parentId, racine si parentId est null.
// Créé par un administrateur (gestion libre depuis /admin/vault ou
// /c/[crmSlug]/vault) ou par un chef de chantier au moment du dépôt d'une
// fiche de pointage (voir src/server/pointage/actions.ts).
model VaultFolder {
  id          String        @id @default(cuid())
  crmId       String
  crm         Crm           @relation(fields: [crmId], references: [id], onDelete: Cascade)
  ownerUserId String
  owner       User          @relation("VaultFolderOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  parentId    String?
  parent      VaultFolder?  @relation("VaultFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    VaultFolder[] @relation("VaultFolderChildren")
  createdById String
  createdBy   User          @relation("VaultFolderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  documents VaultDocument[]

  @@index([crmId, ownerUserId, parentId])
}

model VaultDocument {
  id           String                @id @default(cuid())
  crmId        String
  crm          Crm                   @relation(fields: [crmId], references: [id], onDelete: Cascade)
  userId       String
  user         User                  @relation("VaultDocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  storageKey   String
  category     VaultDocumentCategory @default(DOCUMENT)
  // Dossier réel (voir VaultFolder). Null = document à la racine du
  // coffre-fort, non classé.
  folderId     String?
  folder       VaultFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User                  @relation("VaultDocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime              @default(now())

  // Renseigné uniquement pour category=TIMESHEET_EMPLOYEE (voir
  // depositEmployeeTimesheets) : relie le PDF déposé à la fiche de
  // pointage source, pour permettre à "Transformer en tableau de
  // comptabilité" (voir src/server/accounting) de relire les heures/
  // indemnités d'origine à partir des documents sélectionnés dans le
  // coffre-fort, sans avoir à reparser le PDF.
  pointageId String?
  pointage   Pointage? @relation(fields: [pointageId], references: [id], onDelete: SetNull)

  // Renseignés uniquement pour category=ACCOUNTING_EXPORT (voir
  // generateAccountingExport) : le chantier couvert par ce tableau et le
  // chef de chantier ayant déposé les fiches de pointage source (lu sur
  // ces fiches, jamais recalculé), pour classer l'onglet Comptabilité par
  // chef de chantier plutôt qu'en simple liste de salariés.
  chantierId String?
  chantier   Chantier? @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  foremanId  String?
  foreman    User?     @relation("VaultDocumentForeman", fields: [foremanId], references: [id], onDelete: SetNull)

  @@index([crmId, userId])
  @@index([pointageId])
  @@index([foremanId])
}

// ============================================================================
// API POUR INTÉGRATIONS EXTERNES (ex. Obsidian) — voir
// src/server/admin/api-keys.ts (émission/révocation, réservé aux
// administrateurs globaux) et src/app/api/public/v1/** (les routes qui
// authentifient une requête via cette clé). Une clé donne accès à toutes
// les données de tous les CRM, équivalent à un administrateur global.
// Selon `permission`, choisi à la création et jamais modifiable ensuite
// (une clé plus permissive = une nouvelle clé) :
//  - READ_ONLY  : uniquement les routes GET.
//  - READ_WRITE : GET + POST/PATCH/DELETE, en réutilisant tel quel le cœur
//    métier des server actions existantes (voir le paramètre optionnel
//    `actorCtx` de createClient/updateClient/... etc.) — mêmes règles
//    métier, mêmes effets de bord (notifications, activité, pipeline...)
//    que depuis l'application elle-même.
// ============================================================================

enum ApiKeyPermission {
  READ_ONLY
  READ_WRITE
}

model ApiKey {
  id          String           @id @default(cuid())
  name        String
  // Jamais stockée en clair — même schéma que Session.tokenHash (voir
  // src/lib/crypto.ts hashToken). keyPrefix est purement d'affichage
  // (identifier la clé dans la liste sans pouvoir la reconstituer).
  keyHash     String           @unique
  keyPrefix   String
  permission  ApiKeyPermission @default(READ_ONLY)
  createdById String
  createdBy   User             @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
}
